      "statement": "md.geometry.base      = -md.materials.rho_ice/md.materials.rho_water*md.geometry.thickness;"
    },
    {
      "source": "Square.par",
      "statement": "md.geometry.surface   = md.geometry.base+md.geometry.thickness;"
    },
    {
      "source": "Square.par",
      "statement": "md.initialization.vx=zeros(md.mesh.numberofvertices,1);"
